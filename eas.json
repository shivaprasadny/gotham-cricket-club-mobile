{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },

    "preview": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.shivaprasadofficial.com/api"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "internal",
        "simulator": false
      }
    },

    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.shivaprasadofficial.com/api"
      },
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "autoIncrement": true
      }
    }
  }
}
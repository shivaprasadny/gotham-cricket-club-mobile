{
  "expo": {
    "name": "Gotham Cricket",
    "slug": "gotham-cricket-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#da9306"
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#2b0540"
    },
    "ios": {
      "buildNumber": "5",
      "supportsTablet": true,
      "bundleIdentifier": "com.shivaprasadnyc.gothamcricketmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Allow Gotham Cricket to use Face ID for secure login",
        "LSApplicationQueriesSchemes": ["whatsapp", "tel", "sms", "mailto"],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.shivaprasadnyc.gothamcricketmobile",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "softwareKeyboardLayoutMode": "resize"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Gotham Cricket to use Face ID for secure login"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cc31b874-cd6f-4142-93e6-519164925364"
      }
    },
    "owner": "shivaprasadnyc"
  }
}
